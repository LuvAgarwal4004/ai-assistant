{
  "expo": {
    "name": "ai-assistant",
    "slug": "ai-assistant",
    "version": "1.0.0",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aiassistant.app"
    },
    "ios": {
      "supportsTablet": true
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aiassistant",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      "@clerk/expo-google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "711451888089-344hv7ja2eodcad84lcm6pnhkt01n8k0.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID": "711451888089-nmlj3gblb3qn8fk9a4h40iqhgipf5pcr.apps.googleusercontent.com",
      "eas": {
        "projectId": "840f8752-acdb-421a-b0af-f9b5ad4e5f7e"
      }
    }
  }
}